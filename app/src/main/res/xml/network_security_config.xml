<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- HTTP is blocked by the provider layer unless the user explicitly enables
         insecure local endpoints. HTTPS remains the default. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
